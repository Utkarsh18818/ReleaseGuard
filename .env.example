# Never commit real credentials. Existing local database password is in .local/.env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
FALKORDB_TARGET=local
# Fill from the cloud instance's Connect details; don't guess the host.
FALKORDB_CLOUD_HOST=
FALKORDB_CLOUD_PORT=6379
FALKORDB_CLOUD_USERNAME=falkordb
FALKORDB_CLOUD_PASSWORD=
# true for TLS-capable endpoints. Free tier may require false; match Connect details.
FALKORDB_CLOUD_SSL=true
# Operational Redis is separate from FalkorDB. Docker overrides host/port.
QUEUE_HOST=127.0.0.1
QUEUE_PORT=6381
# Generate QUEUE_PASSWORD in ignored .local/.env using environment/prepare-secrets.py.
